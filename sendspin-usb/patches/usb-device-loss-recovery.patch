+    def _check_stream_health(self, now_us: int) -> None:
+        """Detect a dead output stream (device unplugged) and try to reopen it.
+
+        PortAudio does not raise into Python when an ALSA device disappears: the
+        callback thread just stops. Without this check the player stays silent
+        until the process is restarted.
+        """
+        if self._audio_format is None or self._device is None:
+            return
+        if not self._device_lost:
+            stream = self._stream
+            if stream is None or not self._stream_started:
+                return
+            last = max(self._last_callback_loop_time_us, self._stream_started_loop_time_us)
+            stalled = now_us - last > self._STREAM_STALL_TIMEOUT_US
+            inactive = not getattr(stream, "active", True)
+            if not (stalled or inactive):
+                return
+            logger.warning(
+                "Audio output stalled for %.1f s (active=%s); output device lost, reopening",
+                (now_us - last) / 1e6,
+                not inactive,
+            )
+            self._device_lost = True
+            self._close_stream()
+        if now_us - self._last_reopen_attempt_us < self._DEVICE_REOPEN_INTERVAL_US:
+            return
+        self._last_reopen_attempt_us = now_us
+        self._reopen_lost_device()
+
+    def _reopen_lost_device(self) -> None:
+        """Re-enumerate PortAudio, find the device again by name, reopen and resync."""
+        assert self._audio_format is not None and self._device is not None
+        old = self._device
+        try:
+            # PortAudio caches the device list from Pa_Initialize(); a re-plugged USB
+            # device is invisible (or has a different index) until we re-initialize.
+            sounddevice._terminate()
+            sounddevice._initialize()
+            found: AudioDevice | None = old
+            if old.alsa_device_name is None:
+                found = next((d for d in query_devices() if d.name == old.name), None)
+            if found is None:
+                logger.info("Output device '%s' not back yet; will retry", old.name)
+                return
+            device = found
+            self.clear()
+            self._device = device  # so set_format() does not fall back to the stale index
+            self.set_format(self._audio_format, device)
+            if self._stream is None:
+                return  # open failed; set_format() logged it and the watchdog retries
+        except Exception as err:  # noqa: BLE001
+            logger.info("Reopening output device '%s' failed (%s); will retry", old.name, err)
+            self._stream = None
+            self._device_lost = True
+            return
+        logger.warning(
+            "Output device '%s' reopened (index %s -> %s); resynchronising",
+            old.name,
+            old.device_id,
+            device.device_id,
+        )
