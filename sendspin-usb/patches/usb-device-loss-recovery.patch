+    def _actual_read_position_us(self) -> int | None:
+        """Server timestamp of the next frame that will actually be read from the queue."""
+        assert self._format is not None
+        chunk = self._current_chunk
+        if chunk is not None:
+            frames = self._current_chunk_offset // self._format.frame_size
+            return chunk.server_timestamp_us + frames * 1_000_000 // self._format.sample_rate
+        try:
+            head: _QueuedChunk = self._queue.queue[0]
+        except IndexError:
