+    def _check_stream_health(self, now_us: int) -> None:
+        """Detect a dead output stream (device unplugged) and reopen it.
+
+        PortAudio does not raise into Python when the output device disappears:
+        the callback thread just stops. Without this check the player stays silent
+        until the process is restarted.
+
+        Only "no audio callback for a while" counts as loss. ``stream.active`` must
+        not be used: start() runs asynchronously on the stream executor, so right
+        after a (re)start the stream legitimately reports inactive.
+        """
+        if self._audio_format is None or self._device is None:
+            return
+        if not self._device_lost:
+            if self._stream is None or not self._stream_started:
+                return
+            last = max(self._last_callback_loop_time_us, self._stream_started_loop_time_us)
+            if now_us - last <= self._STREAM_STALL_TIMEOUT_US:
+                return
+            logger.warning(
+                "No audio callback for %.1f s; output device lost, reopening",
+                (now_us - last) / 1e6,
+            )
+            self._device_lost = True
+            self._close_stream()
+        if now_us - self._last_reopen_attempt_us < self._DEVICE_REOPEN_INTERVAL_US:
+            return
+        self._last_reopen_attempt_us = now_us
+        # Reopen the same device. If it is still gone, either opening fails
+        # (set_format() catches PortAudioError and keeps _device_lost set) or the new
+        # stream gets no callbacks and the check above fires again. Either way we
+        # retry every _DEVICE_REOPEN_INTERVAL_US until the device is back.
+        self.clear()
+        self.set_format(self._audio_format, self._device)
